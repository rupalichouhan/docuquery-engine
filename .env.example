# DocuQuery Engine Environment Variables

# Application
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# PostgreSQL + pgvector Database Configuration
POSTGRES_USER=docuquery
POSTGRES_PASSWORD=docuquery_password
POSTGRES_DB=docuquery
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://docuquery:docuquery_password@localhost:5432/docuquery

# Graph Database (KùzuDB embedded path)
KUZU_DB_PATH=./data/kuzu.db

# Local File Storage
UPLOAD_DIR=./data/uploads
MAX_FILE_SIZE_MB=20

# Google Gemini API Key (Obtain free at https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# FastEmbed & FlashRank settings (Running locally on CPU)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
